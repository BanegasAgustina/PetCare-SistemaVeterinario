# Copiar a backend/.env solo para desarrollo. No copiar secretos de producción ni subir backend/.env.
NODE_ENV=development
PORT=3000

# DB local de ejemplo. Para Layerbase usar el host/usuario/password del entorno autorizado
# y DB_SSL_MODE=required o verify_identity. No ejecutar migraciones sin revisión.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=petcare
DB_USER=petcare
DB_PASSWORD=
DB_SSL_MODE=disabled
DB_CONNECTION_LIMIT=5
DB_CONNECT_TIMEOUT_MS=30000

# Valores de reemplazo local, no válidos para despliegue. Usar secretos aleatorios distintos (>=32 bytes).
JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_ISSUER=petcare-api
JWT_AUDIENCE=petcare-mobile
EMAIL_CODE_SECRET=replace-with-a-different-32-byte-random-secret
BCRYPT_SALT_ROUNDS=12

# OAuth opcional; completar con credenciales de desarrollo del proveedor.
BACKEND_URL=http://localhost:3000
OAUTH_RETURN_URLS=http://localhost:8081/oauth,petcare://oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_GRAPH_VERSION=
X_CLIENT_ID=
X_CLIENT_SECRET=

# SMTP se necesita para códigos, recuperación e invitaciones.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# URL base del frontend que recibirá todos los enlaces por correo. En Vercel backend: https://petcare-sistemaveterinario-mobile.vercel.app
PUBLIC_FRONTEND_URL=http://localhost:8081
# Opcionales: cron y almacenamiento privado.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082
CRON_SECRET=replace-with-a-different-32-byte-random-secret
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
REGION=
BUCKET=
ENDPOINT=
PET_PHOTO_S3_URL_STYLE=virtual
STORE_DEMO_MODE=false
REGISTER_DIAGNOSTICS=false
