# ==============================================================================
# PetCare API - Variables de Entorno (Plantilla de Configuración)
# ==============================================================================
# Copiar este archivo como .env para desarrollo local.
# En producción (Vercel), configurar estas variables en Project Settings -> Environment Variables.

# Entorno: development | test | production
NODE_ENV=development
PORT=3000

# URL pública base del backend (en producción: https://pet-care-sistema-veterinario.vercel.app sin /api)
BACKEND_URL=http://localhost:3000

# Base de Datos (MariaDB / MySQL en Layerbase para producción; local para desarrollo)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=petcare
DB_USER=root
DB_PASSWORD=
# DB_SSL_MODE: disabled (solo desarrollo local) | required | verify_identity (Layerbase/producción)
DB_SSL_MODE=disabled
DB_CONNECTION_LIMIT=5
DB_CONNECT_TIMEOUT_MS=30000

# Seguridad JWT (Cadena aleatoria de al menos 32 caracteres)
JWT_ACCESS_SECRET=cambiar_por_clave_secreta_aleatoria_de_al_menos_32_caracteres_hexadecimales
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=petcare-api
JWT_AUDIENCE=petcare-mobile
BCRYPT_SALT_ROUNDS=12

# Orígenes CORS adicionales (separados por coma; el cliente React Native/APK no requiere CORS).
# La web oficial y sus previews petcare-sistemaveterinario-mobile-*.vercel.app ya están permitidos.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,https://petcare-sistemaveterinario-mobile.vercel.app

# Destinos de retorno autorizados para OAuth (separados por coma)
# En producción debe incluir el esquema nativo y la URL web de producción
OAUTH_RETURN_URLS=http://localhost:8081/oauth,petcare://oauth,https://petcare-sistemaveterinario-mobile.vercel.app/oauth

# URLs de activación e invitaciones por email (pantallas del frontend)
ACCOUNT_INVITATION_URL=http://localhost:8081/activate-account
VETERINARIAN_INVITATION_URL=http://localhost:8081/activate-vet
PASSWORD_RESET_URL=http://localhost:8081/reset-password

# Servicio de Correo SMTP (Verificación y Recuperación de Contraseña)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
EMAIL_CODE_SECRET=cambiar_por_clave_secreta_aleatoria_para_codigos_de_verificacion_email

# Procesamiento de recordatorios y entrega Expo Push (solo backend/Vercel; mínimo 32 caracteres).
CRON_SECRET=
# Opcional: configurarlo si se activa la seguridad de acceso de Expo Push Service.
EXPO_PUSH_ACCESS_TOKEN=

# Proveedores OAuth (Google, Meta/Facebook, X/Twitter)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_GRAPH_VERSION=v26.0

X_CLIENT_ID=
X_CLIENT_SECRET=
# Compatibilidad con variables previas de Twitter:
# TWITTER_CLIENT_ID=
# TWITTER_CLIENT_SECRET=

# Almacenamiento multimedia opcional (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
