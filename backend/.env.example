# Copiar a .env y completar los datos de una instancia local MySQL 8.
NODE_ENV=development
# Diagnóstico temporal del registro; sin secretos y deshabilitado en producción.
REGISTER_DIAGNOSTICS=false
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=petcare
DB_USER=petcare
DB_PASSWORD=
# Límite de conexiones simultáneas y tiempo máximo al abrir una conexión.
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT_MS=5000
# Generar una clave aleatoria propia de al menos 32 bytes y guardarla solo en .env.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_ISSUER=petcare-api
JWT_AUDIENCE=petcare-mobile
BCRYPT_SALT_ROUNDS=12
# Clave independiente aleatoria de al menos 32 bytes para HMAC de códigos, solo backend.
EMAIL_CODE_SECRET=
# SMTP real. TLS obligatorio; completar remitente autorizado por el proveedor.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Solo necesario para pruebas en navegador; no se usan cookies de sesión.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
# URL HTTPS de la pantalla activate-vet publicada (sin query/fragmento). Local: http://localhost:8081/activate-vet
VETERINARIAN_INVITATION_URL=
