# Copiar a .env y completar los datos de una instancia local MySQL 8.
NODE_ENV=development
# Diagnóstico temporal del registro; sin secretos y deshabilitado en producción.
REGISTER_DIAGNOSTICS=false
PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=petcare
DB_USER=petcare
DB_PASSWORD=
# TLS required on Layerbase: required for pooled endpoint; verify_identity for direct endpoint.
# Use disabled only for local MySQL.
DB_SSL_MODE=disabled
DB_CONNECTION_LIMIT=5
DB_CONNECT_TIMEOUT_MS=30000
# Generar una clave aleatoria propia de al menos 32 bytes y guardarla solo en .env.
JWT_ACCESS_SECRET=
JWT_ACCESS_TTL_SECONDS=900
# Renovación con caducidad absoluta de familia; entre 1 hora y 90 días.
JWT_REFRESH_TTL_SECONDS=2592000
# Pantalla pública activate-account publicada. SMTP se reutiliza del flujo veterinario.
ACCOUNT_INVITATION_URL=
JWT_ISSUER=petcare-api
JWT_AUDIENCE=petcare-mobile
BCRYPT_SALT_ROUNDS=12
# Origen HTTPS público del backend, sin /api. No usar EXPO_PUBLIC_API_URL para esto.
BACKEND_URL=
# Destinos exactos del callback. Web debe usar el origen real de Expo publicado.
OAUTH_RETURN_URLS=petcare://oauth,http://localhost:8081/oauth,https://petcare-sistemaveterinario-mobile.vercel.app/oauth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Versión soportada elegida en Meta Developers, por ejemplo vNN.N. No usar ese marcador como valor.
FACEBOOK_GRAPH_VERSION=
X_CLIENT_ID=
X_CLIENT_SECRET=
# Compatibilidad con instalaciones existentes: si X_* falta, se leen TWITTER_CLIENT_ID / TWITTER_CLIENT_SECRET.
# Lectura de fotos legacy alojadas en S3. Las nuevas fotos de mascotas y productos usan Cloudinary.
BUCKET=
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
REGION=
ENDPOINT=
# Usar el estilo indicado en Credentials: virtual (actual) o path (bucket antiguo).
PET_PHOTO_S3_URL_STYLE=virtual
# Cloudinary guarda fotos persistentes de perfiles, mascotas y productos (exclusivo backend).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Clave independiente aleatoria de al menos 32 bytes para HMAC de códigos, solo backend.
EMAIL_CODE_SECRET=
# SMTP real. TLS obligatorio; completar remitente autorizado por el proveedor.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# URL pública de la app Expo/Vercel, terminada en /reset-password (sin query ni fragmento).
PASSWORD_RESET_URL=https://tu-app.vercel.app/reset-password
# Solo necesario para pruebas en navegador; no se usan cookies de sesión.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082,https://petcare-sistemaveterinario-mobile.vercel.app,https://petcare-sistemaveterinario-mobile-drpos021a.vercel.app
# URL HTTPS de la pantalla activate-vet publicada (sin query/fragmento). Local: http://localhost:8081/activate-vet
VETERINARIAN_INVITATION_URL=
