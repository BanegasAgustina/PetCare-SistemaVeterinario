# Desarrollo móvil con Expo. EXPO_PUBLIC_* se empaqueta en el cliente: nunca pongas secretos aquí.
EXPO_PUBLIC_APP_ENV=development

# Opcional: descomentar y reemplazar por el origen HTTPS de la API (incluye /api).
# EXPO_PUBLIC_DEV_API_URL=https://api.example.invalid/api

# Sin URL explícita, Expo deriva host LAN de Metro y usa este puerto local.
EXPO_PUBLIC_API_PORT=3000
# Para emulador Android, alternativa local explícita:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api
