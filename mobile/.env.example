# ==============================================================================
# PetCare Mobile - Variables de Entorno (Plantilla de Configuración)
# ==============================================================================
# Copiar este archivo como .env para desarrollo local.
#
# Regla: Las variables EXPO_PUBLIC_* son públicas y se compilan estáticamente en el bundle.
# NUNCA agregues claves privadas de bases de datos ni secretos de API en este archivo.

# Desarrollo local en navegador web:
# EXPO_PUBLIC_API_URL=http://localhost:3000/api

# Desarrollo local en emulador Android oficial:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api

# Desarrollo local con Expo Go en celular físico conectado a la misma red Wi-Fi:
# (Reemplazar 192.168.1.X por la dirección IP privada de tu computadora)
# EXPO_PUBLIC_API_URL=http://192.168.1.X:3000/api

# Producción (Web en Vercel y APK de producción):
# En compilaciones de release (APK / web pública) este valor se utiliza automáticamente
# si la variable no está definida, pero puede configurarse explícitamente:
EXPO_PUBLIC_API_URL=https://pet-care-sistema-veterinario.vercel.app/api
