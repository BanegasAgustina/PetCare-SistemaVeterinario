{
  "expo": {
    "web": {
      "favicon": "./src/assets/petcare-icon.png"
    },
    "version": "0.1.0",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "name": "PetCare",
    "orientation": "portrait",
    "slug": "petcare",
    "scheme": "petcare",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#def1ea",
        "foregroundImage": "./src/assets/petcare-icon.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.anonymous.petcare"
    },
    "icon": "./src/assets/petcare-icon.png",
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "defaultChannel": "petcare-notifications",
          "color": "#def1ea"
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "PetCare necesita acceso a tu galería para elegir la foto de tu mascota.",
          "cameraPermission": "PetCare usa la cámara para tomar fotos de perfil y de mascotas.",
          "microphonePermission": false
        }
      ],
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/petcare-logo-dark.png",
          "imageWidth": 260,
          "backgroundColor": "#ffffff"
        }
      ]
    ]
  }
}
