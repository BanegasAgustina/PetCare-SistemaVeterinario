{
  "expo": {
    "web": {
      "favicon": "./src/assets/petcare-icon.png"
    },
    "version": "0.1.0",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "name": "PetCare",
    "orientation": "portrait",
    "slug": "petcare",
    "scheme": "petcare",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#def1ea",
        "foregroundImage": "./src/assets/petcare-icon.png"
      },
      "softwareKeyboardLayoutMode": "resize"
    },
    "icon": "./src/assets/petcare-icon.png",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      ["expo-image-picker", {"photosPermission":"PetCare necesita acceso a tu galería para elegir la foto de tu mascota.","cameraPermission":false,"microphonePermission":false}]
    ]
  }
}
